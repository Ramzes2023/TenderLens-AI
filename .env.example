# Loaded into environment on startup; existing environment values take priority.
# Telegram and GigaChat settings; readable PDFs are analyzed when LLM is configured.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
# Optional general HTTP proxy; empty = normal direct/system networking.
OUTBOUND_PROXY_URL=
# Optional Telegram override; empty = fall back to OUTBOUND_PROXY_URL.
TELEGRAM_PROXY_URL=
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_TIMEOUT=30
GIGACHAT_CA_BUNDLE_FILE=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
# Phase 7 local SQLite database. The data/ directory is ignored by Git.
DATABASE_URL=sqlite:///./data/tenderlens.db
DATA_DIR=./data

# Normalized PDF characters sent to AI (1..50000); default 20000.
TENDER_ANALYSIS_MAX_CHARS=20000

# Versioned non-secret company profile used by deterministic Phase 6 scoring.
COMPANY_PROFILE_FILE=config/company_profile.example.json

# Phase 8.1 semantic RAG: local multilingual FastEmbed + Qdrant local mode.
# No paid embedding API is required. Set provider=gigachat only if your account has embedding access.
# Reuses GIGACHAT_CREDENTIALS/SCOPE/CA bundle and OUTBOUND_PROXY_URL above.
RAG_ENABLED=true
RAG_QDRANT_PATH=./data/qdrant
RAG_QDRANT_COLLECTION=tenderlens_chunks_v2_local
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=7000
