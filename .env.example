# Loaded into environment on startup; existing environment values take priority.
# Telegram and standalone GigaChat settings; no automatic PDF-to-LLM calls.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
# Optional general HTTP proxy; empty = normal direct/system networking.
OUTBOUND_PROXY_URL=
# Optional Telegram override; empty = fall back to OUTBOUND_PROXY_URL.
TELEGRAM_PROXY_URL=
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_TIMEOUT=30
GIGACHAT_CA_BUNDLE_FILE=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
# Planned local SQL option; no database is created yet.
DATABASE_URL=sqlite:///./data/tenderlens.db
DATA_DIR=./data
