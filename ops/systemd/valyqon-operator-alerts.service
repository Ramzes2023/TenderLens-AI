# Template only. NOT installed or enabled by this repository.
# Requires a dedicated unprivileged valyqon-monitor user and host Python runtime.
[Unit]
Description=VALYQON AI operator Telegram alert check (no customer data)
Documentation=https://github.com/Ramzes2023/TenderLens-AI
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/opt/valyqon/current

[Service]
Type=oneshot
User=valyqon-monitor
Group=valyqon-monitor
WorkingDirectory=/opt/valyqon/current
Environment=PYTHON_DOTENV_DISABLED=1
EnvironmentFile=/etc/valyqon/operator-alerts.env
StateDirectory=valyqon-operator
UMask=0077
ExecStart=/usr/bin/flock -n /var/lib/valyqon-operator/alert.lock /opt/valyqon/current/.venv/bin/python -m app.observability.operator_alerts --send
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/valyqon-operator
# A read-only DB role, controlled network egress and permissions for Caddy
# access logs must be provisioned separately. This unit does not install them.
