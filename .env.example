# Loaded into environment on startup; existing environment values take priority.
# Telegram and GigaChat settings; readable PDFs are analyzed when LLM is configured.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
# Optional general HTTP proxy; empty = normal direct/system networking.
OUTBOUND_PROXY_URL=
# Optional Telegram override; empty = fall back to OUTBOUND_PROXY_URL.
TELEGRAM_PROXY_URL=
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_TIMEOUT=30
GIGACHAT_CA_BUNDLE_FILE=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
# Canonical database configuration: SQLite for local/test use; PostgreSQL for future cutover.
DATABASE_URL=sqlite:///./data/tenderlens.db
# Future PostgreSQL deployments must set this to true and supply DATABASE_URL securely.
# See docs/PHASE24S1A_POSTGRESQL.md. Do not put real credentials in example files.
VALYQON_DATABASE_REQUIRE_POSTGRES=false
VALYQON_DB_POOL_MIN=1
VALYQON_DB_POOL_MAX=10
VALYQON_DB_POOL_TIMEOUT=10
DATA_DIR=./data

# Normalized PDF characters sent to AI (1..50000); default 20000.
TENDER_ANALYSIS_MAX_CHARS=20000

# Versioned non-secret company profile used by deterministic Phase 6 scoring.
COMPANY_PROFILE_FILE=config/company_profile.example.json

# Phase 8.1 semantic RAG: local multilingual FastEmbed + Qdrant local mode.
# No paid embedding API is required. Set provider=gigachat only if your account has embedding access.
# Reuses GIGACHAT_CREDENTIALS/SCOPE/CA bundle and OUTBOUND_PROXY_URL above.
RAG_ENABLED=true
RAG_QDRANT_PATH=./data/qdrant
RAG_QDRANT_COLLECTION=tenderlens_chunks_v2_local
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=7000

# Phase 9 EIS monitoring. Paste full RSS URL(s) copied from an EIS filtered-search RSS link.
# Multiple feeds: separate with a semicolon. Manual /tenders works when URL is configured.
# Background notifications additionally require MONITORING_ENABLED=true and /monitor_on in Telegram.
MONITORING_ENABLED=false
MONITOR_INTERVAL_SECONDS=600
MONITOR_MAX_ITEMS=20
MONITOR_MAX_NOTIFICATIONS_PER_CYCLE=5
MONITOR_REQUEST_TIMEOUT=30
EIS_RSS_URLS=
# Phase 13 multi-company: when enabled, VALYQON AI builds per-company EIS search feeds
# from the active profile's search_keywords/product_keywords. Static EIS_RSS_URLS remains fallback.
EIS_PROFILE_FEEDS_ENABLED=true
EIS_PROFILE_FEED_LIMIT=5
# Optional EIS-specific CA file. Empty = reuse GIGACHAT_CA_BUNDLE_FILE when present, otherwise system trust.
EIS_CA_BUNDLE_FILE=

# Phase 10 FastAPI. Defaults bind only to localhost.
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
# Only these proxy IPs/CIDRs may supply X-Forwarded-* metadata.
# Keep localhost for normal local mode. Public Docker deployment will
# override this with trusted private Docker-network ranges while API :8000
# remains unexposed to the Internet.
TENDERLENS_TRUSTED_PROXY_IPS=127.0.0.1
# Optional. If set, all /api/v1/* routes require header: X-API-Key: <value>.
# /health and OpenAPI docs remain available for local readiness checks.
TENDERLENS_API_KEY=

# Phase 24N email verification.
# Registration requires a configured email sender.
# Keep disabled for local environments that must not send real email.
# In production, VALYQON_PUBLIC_BASE_URL must be the canonical HTTPS
# origin used in verification links, for example https://app.example.com.
VALYQON_EMAIL_MODE=disabled
VALYQON_PUBLIC_BASE_URL=
VALYQON_SMTP_HOST=
VALYQON_SMTP_PORT=587
VALYQON_SMTP_FROM=
VALYQON_SMTP_USERNAME=
VALYQON_SMTP_PASSWORD=
VALYQON_SMTP_STARTTLS=true
VALYQON_SMTP_SSL=false
VALYQON_SMTP_TIMEOUT_SECONDS=10

# Phase 11 Docker deployment. Compose binds to localhost by default; change deliberately for remote exposure.

# Docker-only network overrides. These intentionally replace host localhost proxies
# inside containers. Leave empty for normal Docker networking. If a proxy is needed,
# use a URL reachable from the container (not 127.0.0.1 on the Windows host).
DOCKER_OUTBOUND_PROXY_URL=
DOCKER_TELEGRAM_PROXY_URL=
TENDERLENS_DOCKER_BIND=127.0.0.1
TENDERLENS_DOCKER_PORT=8000
# Used by the container HEALTHCHECK; normally leave unchanged.
TENDERLENS_HEALTHCHECK_URL=http://127.0.0.1:8000/health

# Comma-separated authenticated platform support operator emails.
VALYQON_SUPPORT_OPERATOR_EMAILS=

# Ephemeral infrastructure: empty URL keeps deterministic local memory operation.
# Production operators must choose a unique namespace and explicitly require Redis.
VALYQON_REDIS_URL=
VALYQON_REDIS_REQUIRED=false
VALYQON_REDIS_POOL_MAX=10
VALYQON_REDIS_CONNECT_TIMEOUT=2
VALYQON_REDIS_SOCKET_TIMEOUT=2
VALYQON_CACHE_NAMESPACE=local

# Phase 24S.1C durable job worker process settings (no workers start in the API).
# VALYQON_WORKER_COUNT=2
# VALYQON_JOB_POLL_SECONDS=0.5
# VALYQON_JOB_LEASE_SECONDS=60
# VALYQON_JOB_HEARTBEAT_SECONDS=10
# VALYQON_JOB_DEFAULT_MAX_ATTEMPTS=3
# VALYQON_JOB_MAX_PAYLOAD_BYTES=262144
# VALYQON_JOB_MAX_RESULT_BYTES=262144
# VALYQON_WORKER_SHUTDOWN_SECONDS=30
