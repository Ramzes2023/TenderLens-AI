# Loaded into environment on startup; existing environment values take priority.
# Only TELEGRAM_BOT_TOKEN, TELEGRAM_PROXY_URL and LOG_LEVEL are used in Phase 2.
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
# Planned local SQL option; no database is created yet.
DATABASE_URL=sqlite:///./data/tenderlens.db
DATA_DIR=./data
