# Public HTTPS edge settings.
# Copy to .env.public on the VPS and replace both values.
TENDERLENS_DOMAIN=tenderlens.example.com
ACME_EMAIL=admin@example.com

# Normally omit these on the VPS: defaults are 80 and 443.
# They are useful for isolated local smoke testing.
# TENDERLENS_HTTP_PORT=18080
# TENDERLENS_HTTPS_PORT=18443
